{
  "name": "fling-launcher",
  "version": "1.2.0",
  "description": "Desktop launcher for Hello Neighbor alpha builds, with optional community multiplayer mod patching.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.flinglauncher.app",
    "productName": "Fling Launcher",
    "files": [
      "main.js",
      "preload.js",
      "toolinstaller.js",
      "index.html",
      "favicon.ico",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
