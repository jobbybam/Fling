{
  "name": "fling-launcher",
  "version": "0.1.0",
  "description": "Desktop launcher for Hello Neighbor alpha builds, with optional community multiplayer mod patching.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.flinglauncher.app",
    "productName": "Fling Launcher",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "favicon.ico",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
